# Copy this file to .env and fill in real values. Never commit .env.

# ---- Server ----
PORT=5000

# ---- Auth (required) ----
# Required at startup — the server refuses to boot without this set.
# Generate a long random value, e.g.: openssl rand -hex 32
JWT_SECRET=

# Set to true only in local/dev environments where you explicitly want an
# unauthenticated "continue with demo" HOD login (no email/password check at
# all). Must be false (or unset) in any shared/staging/production
# deployment. Never set this in deployment docs or CI/CD configuration.
ALLOW_DEMO_LOGIN=false

# Seeds the two placeholder accounts shown pre-filled on the login screen
# (hod@college.edu / hod12345 and faculty@college.edu / faculty12345) into
# the database on every boot. Defaults to true so the credentials printed
# on the login page work in every environment, including production demos.
# Set to false once you replace these with real accounts (via /api/auth/register).
SEED_DEMO_USERS=true

# ---- Database ----
# MongoDB is required. The server will refuse to start without a valid URI.
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/faculty_allocation
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# ---- AI (Groq, OpenAI-compatible) ----
# If GROQ_API_KEY is unset, the agent falls back to local deterministic
# tools only (no LLM classification/explanation).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Email (Brevo transactional email) ----
# If either of these is unset, email notifications are skipped (allocation
# decisions still succeed; see routes/allocations.js notifyDecision()).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Faculty Course Allocation Agent
